// Application resources. The first icon (lowest ID) is what Windows Explorer / the taskbar show for
// the .exe. launcher.ico is a multi-size icon (16/24/32/48/64/128/256) - the ribbon-wave app icon.
#include "resource.h"

IDI_APPICON ICON "launcher.ico"

// Version resource. Its FileDescription ("Launcher") is the friendly process name Windows shows - so
// Task Manager's Processes tab lists it as "Launcher" instead of "launcher.exe". (It is NOT what fixed
// the taskbar/Alt-Tab caption - that was the DefWindowProcA -> DefWindowProcW bug.)
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Human Made"
            VALUE "FileDescription",  "Launcher"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "Launcher"
            VALUE "OriginalFilename", "launcher.exe"
            VALUE "ProductName",      "Launcher"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
